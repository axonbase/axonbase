{
  "name": "axonbase/sdk",
  "description": "AxonBase WebSocket JSON-RPC client for PHP",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/axonbase/sdk-php",
  "support": {
    "issues": "https://github.com/axonbase/axonbase/issues",
    "source": "https://github.com/axonbase/sdk-php"
  },
  "require": {
    "php": ">=8.1",
    "textalk/websocket": "^1.6"
  },
  "autoload": {
    "psr-4": { "AxonBase\\": "src/" },
    "files": ["src/Error.php"]
  },
